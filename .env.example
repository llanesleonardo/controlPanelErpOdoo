# Control-plane / app secrets (placeholders only — never commit real values)

# --- Deployment profile & tenancy (env / GitHub Actions vars / Azure App Settings) ---
# single_tenant = one customer per stack (TENANT_ID fixed from env)
# multi_tenant = shared stack; per-request tenant via X-Tenant-Id (TENANT_ID = default/fallback)
DEPLOYMENT_MODE=single_tenant
TENANT_ID=default
# Product-owned ontology rebind pack (see resources/packages/ontology)
DEPLOYMENT_PROFILE=reference_carbide
# Optional: surfaced in web build (must match gateway at deploy time)
NEXT_PUBLIC_DEPLOYMENT_MODE=single_tenant

# --- GitHub Packages (patterns docs sync) ---
NODE_AUTH_TOKEN=

# --- Control-plane PostgreSQL (separate from Odoo) ---
CONTROLPLANE_DB_HOST=localhost
CONTROLPLANE_DB_PORT=5433
CONTROLPLANE_DB_NAME=controlpanel
CONTROLPLANE_DB_USER=controlpanel
CONTROLPLANE_DB_PASSWORD=change-me
# Host port 5433 avoids clashing with a local Postgres on 5432
DATABASE_URL=postgresql://controlpanel:change-me@localhost:5433/controlpanel?schema=public

# --- NestJS gateway ---
GATEWAY_PORT=3001
GATEWAY_JWT_SECRET=change-me
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SERVICE_NAME=gateway
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- FastAPI orchestrator ---
ORCHESTRATOR_PORT=8000
ORCHESTRATOR_URL=http://localhost:8000

# --- Next.js web ---
WEB_PORT=3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001

# --- Odoo 18 connector (external system of record) ---
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=
ODOO_PASSWORD=
# Prefer API key when available
ODOO_API_KEY=
# live = call Odoo JSON-RPC; simulate = domain evidence without ERP
ODOO_MODE=simulate
ERP_MODE=simulate

# --- Storage (local now; Linux host path later) ---
STORAGE_ROOT=./resources/storage/local

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=./resources/logs
