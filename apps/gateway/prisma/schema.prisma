generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskState {
  pending
  running
  completed
  failed
  needs_approval
  rejected
}

enum ExecutionMode {
  dry_run
  commit
}

model Task {
  id             String        @id @default(uuid())
  correlationId  String        @map("correlation_id")
  actorId        String        @map("actor_id")
  intentCode     String        @map("intent_code")
  skillId        String?       @map("skill_id")
  state          TaskState
  executionMode  ExecutionMode @map("execution_mode")
  input          Json
  output         Json?
  error          Json?
  approvedBy     String?       @map("approved_by")
  approvedAt     DateTime?     @map("approved_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([correlationId])
  @@index([state])
  @@index([createdAt])
  @@map("tasks")
}

enum ErpProvider {
  odoo
}

enum ErpConnectorStatus {
  ok
  degraded
  down
  unknown
}

model ErpConnectorConfig {
  id           String             @id @default(uuid())
  provider     ErpProvider        @default(odoo)
  key          String             @unique @default("default")
  url          String             @default("")
  dbName       String             @default("") @map("db_name")
  username     String             @default("")
  secret       String             @default("")
  lastCheckedAt DateTime?         @map("last_checked_at")
  status       ErpConnectorStatus @default(unknown)
  lastError    String?            @map("last_error")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@map("erp_connector_configs")
}
