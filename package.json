{
  "name": "control-panel-erp",
  "version": "0.0.1",
  "private": true,
  "description": "OpenClaw–Odoo 18 control panel — scaffold and reference docs",
  "workspaces": [
    "packages/*",
    "apps/gateway",
    "apps/web"
  ],
  "scripts": {
    "docs:sync-patterns": "npx software-patterns-docs-sync --dir .",
    "lint": "markdownlint \"docs/Components/**/*.md\" \"docs/Deployment/**/*.md\" \"docs/Development/**/*.md\" \"docs/README.md\" \"README.md\" \"apps/**/*.md\" \"packages/**/*.md\" \"docker/**/*.md\" \".github/**/*.md\"",
    "test:contracts": "npm test -w @control-panel-erp/contracts",
    "test:ontology": "npm test -w @control-panel-erp/ontology",
    "contracts:sync": "npm run sync-schemas -w @control-panel-erp/contracts",
    "dev:gateway": "npm run start:dev -w @control-panel-erp/gateway",
    "dev:web": "npm run dev -w @control-panel-erp/web",
    "dev:orchestrator": "cd apps/orchestrator && python -m uvicorn app.main:app --reload --port 8000",
    "prisma:push": "npm run prisma:push -w @control-panel-erp/gateway",
    "prisma:generate": "npm run prisma:generate -w @control-panel-erp/gateway"
  },
  "dependencies": {
    "@llanesleonardo/software-patterns-docs": "0.1.1"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.45.0"
  },
  "engines": {
    "node": ">=20"
  }
}
