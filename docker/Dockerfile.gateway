# NestJS gateway — npm workspaces hoist deps to /app/node_modules
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
COPY resources/packages/contracts/package.json ./packages/contracts/
COPY resources/packages/ontology/package.json ./packages/ontology/
COPY apps/gateway/package.json ./apps/gateway/
RUN npm install --workspace=@control-panel-ontology/gateway --workspace=@control-panel-ontology/contracts --workspace=@control-panel-ontology/ontology --include-workspace-root=false

FROM node:20-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/package-lock.json* ./
COPY resources/packages/contracts ./packages/contracts
COPY resources/packages/ontology ./packages/ontology
COPY apps/gateway ./apps/gateway
WORKDIR /app/apps/gateway
RUN npx prisma generate && npx nest build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/packages/contracts ./packages/contracts
COPY --from=build /app/packages/ontology ./packages/ontology
COPY --from=build /app/apps/gateway/dist ./dist
COPY --from=build /app/apps/gateway/package.json ./package.json
COPY --from=build /app/apps/gateway/prisma ./prisma
COPY --from=build /app/node_modules ./node_modules
EXPOSE 3001
CMD ["sh", "-c", "npx prisma db push && node dist/main.js"]
